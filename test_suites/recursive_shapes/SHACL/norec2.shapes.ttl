prefix :       <http://example.org/> 
prefix sh:     <http://www.w3.org/ns/shacl#> 
prefix xsd:    <http://www.w3.org/2001/XMLSchema#>

:S a sh:NodeShape ;
  sh:property [ sh:path :p ;
                sh:qualifiedValueShape [ sh:not [ sh:node :T ] ] ;
                sh:qualifiedMinCount 1 ;
  ]  .

:T a sh:NodeShape ;
   sh:hasValue :a .

